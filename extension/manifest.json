{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Dust Out",
  "version": "1.0.2",
  "description": "Snap your fingers on a video call and crumble into dust. Come back a minute later.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*",
    "https://meet.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*", "https://meet.google.com/*"],
      "js": ["ext-mode.js", "dust-out.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*", "https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
